# Copy to .env. This file contains placeholders only; never commit the real .env.

# The API is reached through the host-published API_PORT, so this Compose stack
# remains independent from docker-compose.prod.yml and its Docker network.
# The shared Mindoist service token is stored separately in ignored .agent-token.
MINDOIST_INTERNAL_URL=http://host.docker.internal:3000
MINDOIST_AI_CONFIG_URL=http://host.docker.internal:3000/internal/agent/ai-config

# Provider/model/API keys are managed in Mindoist Admin. PicoClaw polls the
# authenticated endpoint and keeps its last-known-good runtime configuration.
PICOCLAW_AI_SYNC_INTERVAL_SECONDS=60

PICOCLAW_LOG_LEVEL=warn
PICOCLAW_MEMORY_LIMIT=512m
PICOCLAW_CPU_LIMIT=0.75
