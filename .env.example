DATABASE_URL=postgresql://mindoist_user:mindoist_pass@localhost:5432/mindoist_db
JWT_SECRET=change-this-to-a-real-secret
PORT=3000

# --- docker-compose.prod.yml only (api + web + postgres) ---
POSTGRES_USER=mindoist_user
POSTGRES_PASSWORD=change-this-to-a-real-secret
POSTGRES_DB=mindoist_db
API_PORT=3000
WEB_PORT=5174

# Public domain (no scheme, no trailing slash) — used to build OAuth redirect
# URLs. TLS is terminated in front of this stack (e.g. Cloudflare), so the
# containers themselves stay on plain HTTP.
DOMAIN=mindoist.workspacesbeat.site

# Optional — only set this if the API is split onto its own subdomain
# instead of sharing DOMAIN with the web app (no scheme, no trailing slash).
# Swaps the Google OAuth redirect URIs below to this domain and makes the
# web build call it directly instead of using relative paths.
# API_DOMAIN=api-mindoist.workspacesbeat.site

# Optional — only needed if Google Calendar / Drive backup integration is enabled.
# Add https://${API_DOMAIN:-$DOMAIN}/auth/google/callback and
# https://${API_DOMAIN:-$DOMAIN}/gcal/callback as authorized redirect URIs
# in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — only needed for web push (task/countdown reminders). Generate a
# pair with `npx web-push generate-vapid-keys`; without these, /push routes
# return "not configured" and the client never subscribes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@mindoist.app

# Optional — IANA time zone used as a fallback for computing due-time
# notifications when a task/countdown has no explicit time zone of its own
# (all-day items, or data from before per-task time zones existed). Defaults
# to Asia/Ho_Chi_Minh if unset.
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Web rollout switches. All v2 paths are enabled by default; set an explicit
# false/off/0 value only for a temporary rollback while diagnosing a release.
VITE_DESIGN_TOKENS_V2=true

# Optional — shared Telegram bot linking. The bot token and model key belong
# only to the PicoClaw deployment; the API needs the public bot username to
# build pairing links and a separate high-entropy service token to authenticate
# the private PicoClaw adapter endpoints.
TELEGRAM_BOT_USERNAME=
MINDOIST_AGENT_TOKEN=
